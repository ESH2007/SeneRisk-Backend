# Copia a .env y exporta antes de correr Django (o usa `set -a; source .env; set +a`)
DJANGO_SECRET_KEY=5dc5689b8c71394b2cccdf1db855ff80
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Supabase → Project → Connect → "Session pooler" (IPv4). Codifica caracteres raros de la clave (%40 para @).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Supabase Storage (Project Settings → Storage → S3 access keys). Bucket público `media` para fotos.
SUPABASE_S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
